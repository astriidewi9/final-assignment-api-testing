                  "const expected = Number(pm.iterationData.get(\"expected_status\"));\r",
                  "\r",
                  "pm.test(`Status code matches expected (${expected})`, function () {\r",
                  "    pm.response.to.have.status(expected);\r",
                  "});\r",
                  "\r",
                  "// Response time dicatat tapi tidak dijadikan syarat lulus/gagal,\r",
                  "// karena waktu respons server lab ini bervariasi cukup besar\r",
                  "// tergantung jumlah data yang sudah tersimpan.\r",
                  "console.log(\"Response time:\", pm.response.responseTime + \"ms\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
